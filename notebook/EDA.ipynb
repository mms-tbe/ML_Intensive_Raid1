# EDA — Telco Customer Churn

Цель: понять структуру данных, найти ловушки типов и пропусков, оценить дисбаланс классов и связь оттока с ключевыми категориальными признаками.
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

DATA = Path('../data/WA_Fn-UseC_-Telco-Customer-Churn.csv')
PLOTS = Path('../results/plots'); PLOTS.mkdir(parents=True, exist_ok=True)
df = pd.read_csv(DATA)
print('shape:', df.shape)
df.dtypes
## Типы и ловушка `TotalCharges`

`TotalCharges` загружается как **`object`**, хотя по смыслу числовой: в части строк стоит пустая строка `" "` (неявный пропуск). Это ловушка типа — лечится `pd.to_numeric(..., errors='coerce')` и импутацией медианой **внутри Pipeline**.

`SeniorCitizen` — числовой 0/1; прочие нечисловые колонки категориальные.
df.head()
## Анализ пропусков: явные `NaN` и неявные пустые строки
explicit = df.isna().sum()
explicit = explicit[explicit > 0]
print('Явные NaN по колонкам:')
print(explicit.to_string() if len(explicit) else 'нет явных NaN')
blank = (df['TotalCharges'].astype(str).str.strip() == '').sum()
print('Неявные пустые строки в TotalCharges:', blank)
tc = pd.to_numeric(df['TotalCharges'], errors='coerce')
print('NaN после to_numeric(TotalCharges):', int(tc.isna().sum()))
print('tenure у этих строк:', df.loc[tc.isna(), 'tenure'].unique())
## Распределение целевой переменной `Churn` (дисбаланс ~73/27)
counts = df['Churn'].value_counts()
print((df['Churn'].value_counts(normalize=True) * 100).round(1))
ax = counts.plot(kind='bar', color=['#4c72b0', '#dd8452'])
ax.set_title('Распределение Churn'); ax.set_ylabel('Количество клиентов')
plt.tight_layout(); plt.savefig(PLOTS / 'churn_distribution.png', dpi=120); plt.show()
## Гистограммы числовых признаков
num = pd.DataFrame({'tenure': df['tenure'],
                    'MonthlyCharges': df['MonthlyCharges'],
                    'TotalCharges': pd.to_numeric(df['TotalCharges'], errors='coerce')})
num.hist(bins=30, figsize=(12, 3), layout=(1, 3))
plt.tight_layout(); plt.savefig(PLOTS / 'numeric_histograms.png', dpi=120); plt.show()
## Кросс-таблицы `Churn` по категориальным признакам

Доля оттока внутри каждой категории (`normalize='index'`).
for col in ['Contract', 'PaymentMethod', 'InternetService']:
    ct = pd.crosstab(df[col], df['Churn'], normalize='index').round(3)
    print('=== Churn rate by', col, '===')
    print(ct.to_string())
    print()
## Инсайты (числа считаются ниже)
c = pd.crosstab(df['Contract'], df['Churn'], normalize='index')['Yes']
p = pd.crosstab(df['PaymentMethod'], df['Churn'], normalize='index')['Yes']
i = pd.crosstab(df['InternetService'], df['Churn'], normalize='index')['Yes']
print('1) Контракт month-to-month: отток {:.0%} против {:.0%} у two-year '
      '— длина контракта сильнейший сигнал.'.format(c['Month-to-month'], c['Two year']))
print('2) Electronic check: отток {:.0%} — заметно выше прочих способов оплаты.'
      .format(p['Electronic check']))
print('3) Fiber optic: отток {:.0%} против {:.0%} у DSL '
      '— оптика связана с более высоким оттоком.'.format(i['Fiber optic'], i['DSL']))
